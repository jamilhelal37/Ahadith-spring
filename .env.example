# Copy this file to .env beside pom.xml, then replace placeholders as needed.
# Do not commit .env or any real secret values.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ahadith
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
PORT=8080
APP_API_LEGACY_SUNSET=

# Docker Compose local PostgreSQL only.
LOCAL_POSTGRES_PORT=5433
LOCAL_POSTGRES_DB=ahadith
LOCAL_POSTGRES_USERNAME=postgres
LOCAL_POSTGRES_PASSWORD=postgres

JWT_SECRET=change-this-to-a-secret-at-least-64-characters-long
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

APP_MAIL_ENABLED=false
APP_MAIL_PROVIDER=resend
RESEND_API_KEY=
APP_MAIL_FROM=
APP_MAIL_FRONTEND_BASE_URL=http://localhost:8080
APP_MAIL_VERIFICATION_BASE_URL=
APP_MAIL_CONNECT_TIMEOUT=5s
APP_MAIL_READ_TIMEOUT=10s
APP_RATE_LIMIT_LOGIN_EMAIL_CAPACITY=10
APP_RATE_LIMIT_LOGIN_EMAIL_WINDOW=1m
APP_CLEANUP_ENABLED=true
APP_CLEANUP_INITIAL_DELAY=10m
APP_CLEANUP_FIXED_DELAY=6h
APP_CLEANUP_TOKEN_RETENTION=7d
APP_CLEANUP_LOGIN_ATTEMPT_RETENTION=30d
APP_CLEANUP_BATCH_SIZE=1000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
APP_MULTIPART_MAX_FILE_SIZE=11MB
APP_MULTIPART_MAX_REQUEST_SIZE=12MB
APP_UPGRADE_DOCUMENT_MAX_SIZE=10MB
APP_UPGRADE_DOCUMENT_MAX_PAGES=20
APP_UPGRADE_DOCUMENT_DOWNLOAD_TTL=5m
APP_RATE_LIMIT_UPGRADE_REQUEST_CREATE_CAPACITY=5
APP_RATE_LIMIT_UPGRADE_REQUEST_CREATE_WINDOW=1d
