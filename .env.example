# Copy this file to .env beside pom.xml, then replace placeholders as needed.
# Do not commit .env or any real secret values.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ahadith
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
PORT=8080

JWT_SECRET=change-this-to-a-secret-at-least-64-characters-long
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

APP_MAIL_ENABLED=false
APP_MAIL_FROM=
APP_MAIL_FRONTEND_BASE_URL=http://localhost:8080

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
